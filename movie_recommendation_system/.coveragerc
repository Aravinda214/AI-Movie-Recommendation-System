# .coveragerc - OPTIMIZED for Milestone 2 Success

[run]
source = .

# Exclude files that are dragging down coverage
omit = 
    # Test files and runners
    test_*.py
    conftest.py
    run_*.py
    *_runner.py
    
    # Unused legacy files (0% coverage)
    create_baseline_stats.py
    data_collection_refactored.py
    drift_monitor.py
    fix_imports.py
    online_monitor.py
    update_baseline.py
    run_milestone2_tests.py
    
    # Virtual environment
    mlipproj/*
    venv/*
    __pycache__/*

[report]
# Focus ONLY on core pipeline modules
include = 
    config.py
    data_loader.py
    data_preprocessor.py
    feature_engineer.py
    data_quality.py
    data_splitter.py
    svd_model_trainer.py
    model_evaluator.py
    main_pipeline.py

precision = 1
show_missing = True

[html]
directory = htmlcov
